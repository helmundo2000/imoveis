PORT=3000

# Proteção do /dashboard e endpoints de escrita (opcional localmente, recomendado online)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Opcional: URL PostgreSQL (ex: Neon ou Supabase gratuito) para persistir dados em cloud efémera
# Se vazio, guarda localmente em data/*.json
DATABASE_URL=

# Tempos do ecrã Digital Signage (em milissegundos)
PROPERTY_DURATION_MS=25000
PHOTO_DURATION_MS=5000
PHOTO_FADE_MS=1000
POLL_INTERVAL_MS=30000

# Sincronização
MAX_PHOTOS_PER_PROPERTY=5
AUTO_SYNC_MINUTES=0
